{
  // --- UI & Rendering (Intel HD 520 GPU & Wayland) ---
  "editor.minimap.enabled": false,
  "editor.cursorBlinking": "solid",
  "editor.renderWhitespace": "none",
  "editor.renderControlCharacters": false,
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  "editor.codeLens": false,
  "editor.lightbulb.enabled": "off",
  "workbench.reduceMotion": "on",
  "terminal.integrated.gpuAcceleration": "on",

  // --- Font & Display (Matches Kitty: JetBrainsMono Nerd Font Mono) ---
  "editor.fontFamily": "'JetBrainsMono Nerd Font Mono', 'JetBrainsMono NFM', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.5,
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono', 'JetBrainsMono NFM'",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.2,

  // --- Search & File Watcher (Saves Dual-Core CPU & RAM) ---
  "search.followSymlinks": false,
  "search.useIgnoreFiles": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.cache/**": true,
    "**/target/**": true,
    "**/venv/**": true,
    "**/.venv/**": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.cache": true
  },

  // --- Background Updates & Telemetry (No random CPU spikes) ---
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",
  "extensions.ignoreRecommendations": true,
  "update.mode": "none",
  "telemetry.telemetryLevel": "off",
  "workbench.enableExperiments": false,

  // --- Git (Prevents continuous repo scanning) ---
  "git.enabled": true,
  "git.autorefresh": true,
  "git.autofetch": false,

  // --- Language Server Memory Cap (8GB RAM safeguard) ---
  "typescript.tsserver.maxTsServerMemory": 2048,
  "typescript.disableAutomaticTypeAcquisition": true,
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Ayu Dark Bordered",

  // --- Disable GitHub Copilot & AI Features ---
  "chat.disableAIFeatures": true,
  "github.copilot.enable": {
    "*": false
  },
  "github.copilot.editor.enableAutoCompletions": false,
  "chat.commandCenter.enabled": false,
  "inlineChat.enabled": false,
  "chat.editor.inlineChat": false,
  "editor.inlineSuggest.enabled": false,
  "workbench.iconTheme": "material-icon-theme"
}
